# Modèle du fichier de configuration de Mon Relais Presta.
# Copier ce fichier sous le nom ".env.local" et remplir les valeurs.
# Le fichier .env.local n'est JAMAIS envoyé sur GitHub (il est ignoré).

# Projet Supabase propre à Mon Relais Presta (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (Project Settings > API Keys > Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adresse publique de l'application (liens WhatsApp et e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Serveur uniquement (jamais visibles dans le navigateur) ----
# Clé secrète Supabase (Project Settings > API Keys > Secret key) : envoi des notifications
SUPABASE_SECRET_KEY=

# E-mails de notification (Gmail : mot de passe d'application, myaccount.google.com/apppasswords)
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=

# Notifications push (clés fabriquées avec : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:votre-adresse@exemple.fr

# Secret de la tâche automatique horaire (une longue suite de caractères au hasard)
TACHES_SECRET=
