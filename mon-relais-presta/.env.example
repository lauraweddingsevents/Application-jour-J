# Modèle du fichier de configuration de Mon Relais Presta.
# Copier ce fichier sous le nom ".env.local" et remplir les valeurs.
# Le fichier .env.local n'est JAMAIS envoyé sur GitHub (il est ignoré).

# Projet Supabase propre à Mon Relais Presta (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (Project Settings > API Keys > Publishable key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adresse publique de l'application (liens WhatsApp et e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
