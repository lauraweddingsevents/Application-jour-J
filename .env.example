# Modèle du fichier de configuration.
# Copier ce fichier sous le nom ".env.local" et remplir les valeurs.
# Le fichier .env.local n'est JAMAIS envoyé sur GitHub (il est ignoré).

# Adresse du projet Supabase (Project Settings > Data API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique Supabase (Project Settings > API Keys > Publishable key)
# Elle peut être visible : ce sont les règles de sécurité de la base qui protègent les données.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Adresse publique de l'application (pour les liens envoyés aux intervenants)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alertes sur téléphone (fabriquées sur la page /reglages/alertes)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ALERTES_SECRET=
